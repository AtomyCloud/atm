{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATM migration plugin contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "description", "order", "min_core_api", "platforms", "executor", "protocol", "operations"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "order": {"type": "integer"},
    "full_setup": {"type": "boolean", "default": false},
    "min_core_api": {"const": 1},
    "platforms": {"const": ["linux"]},
    "executor": {"const": "legacy-bash"},
    "protocol": {"const": "tty-v1"},
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["menu", "status", "install", "remove", "uninstall", "use"]}
    }
  }
}
