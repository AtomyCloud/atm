{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATM native plugin contract v2",
  "description": "Native API 2; independent of legacy Bash CORE API 1. Runtime additionally checks platform coverage, portable paths, regular files and binary architecture.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "description", "order", "min_core_api", "platforms", "executor", "protocol", "operations", "executables"],
  "properties": {
    "schema": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "order": {"type": "integer"},
    "full_setup": {"type": "boolean", "default": false},
    "min_core_api": {"const": 2},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["linux", "windows", "darwin"]}},
    "executor": {"const": "native"},
    "protocol": {"const": "jsonl-v1"},
    "operations": {
      "description": "integrate is optional: plugin-owned user PATH/CLI/desktop integration, explicitly consented, with no arguments and no legacy fallback. A backend must report unsupported or incomplete integration as a non-success result.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["status", "install", "update", "remove", "uninstall", "use", "integrate"]}
    },
    "executables": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "linux/amd64": {"$ref": "#/$defs/path"},
        "linux/arm64": {"$ref": "#/$defs/path"},
        "darwin/amd64": {"$ref": "#/$defs/path"},
        "darwin/arm64": {"$ref": "#/$defs/path"},
        "windows/amd64": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.[eE][xX][eE]$"}]}
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:[. ]/|[. ]$))[^\\\\:\\u0000-\\u001f\\u007f<>\"|?*]+$"}
  }
}
